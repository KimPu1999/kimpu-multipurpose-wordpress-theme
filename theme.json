{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#137c66",
          "name": "Primary"
        },
        {
          "slug": "dark",
          "color": "#17283b",
          "name": "Dark"
        },
        {
          "slug": "text",
          "color": "#34465a",
          "name": "Text"
        },
        {
          "slug": "surface",
          "color": "#f4f8f7",
          "name": "Surface"
        },
        {
          "slug": "accent",
          "color": "#e3a857",
          "name": "Accent"
        },
        {
          "slug": "border",
          "color": "#e2e8f0",
          "name": "Border"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif",
          "slug": "system",
          "name": "System Sans"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "normal",
          "size": "1rem",
          "name": "Normal"
        },
        {
          "slug": "large",
          "size": "1.5rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "2.5rem",
          "name": "Extra Large"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "text": "#34465a",
      "background": "#ffffff"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "lineHeight": "1.65"
    }
  }
}
